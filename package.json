{
  "name": "marvel-comics",
  "version": "0.1.0",
  "private": true,
  "main": "electron.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:export": "next build",
    "start": "next start",
    "lint": "eslint .",
    "clean": "next clean",
    "build:exe": "next build && electron-builder --win nsis",
    "cap:sync": "next build && node scripts/prepare-capacitor.js && npx cap sync",
    "cap:assets": "npx @capacitor/assets generate --android",
    "build:android": "next build && node scripts/prepare-capacitor.js && npx cap sync"
  },
  "build": {
    "appId": "com.marvel.comics",
    "productName": "Marvel Comics",
    "asar": false,
    "files": [
      "electron.js",
      ".next/**/*",
      "public/**/*",
      "data/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.2.1",
    "@supabase/supabase-js": "^2.112.2",
    "adm-zip": "^0.6.0",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "node-unrar-js": "^2.0.2",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1",
    "tar": "^7.5.22",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/tar": "^7.0.87",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "firebase-tools": "^15.0.0",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  }
}
